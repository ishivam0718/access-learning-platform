# Copy this to .env and fill in your actual values
# NEVER commit .env file to git!

# MongoDB connection string (get from MongoDB Atlas)
MONGO_URI=mongodb+srv://username:password@cluster-name.mongodb.net/access_learning?retryWrites=true&w=majority

# JWT secret for signing tokens (use any random string)
JWT_SECRET=your_very_secret_key_change_this_in_production

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Port (Netlify will override this in production)
PORT=5000

# Node environment
NODE_ENV=development
